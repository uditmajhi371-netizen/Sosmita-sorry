sition:.2s}button:hover{transform:translateY(-2px);box-shadow:0 8px 18px #d45f9133}.choice-main{background:linear-gradient(90deg,#e77ba7,#d65b91);color:white}.choice-soft{background:#fff0f6;border:1px solid #f4c3d7;color:#b65380}#response{display:none;background:#fff0f6;border:1px dashed #e9a4bf;border-radius:15px;padding:15px;margin-top:15px;line-height:1.7;color:#a84975;text-align:center}.surprise{text-align:center}.panda{width:100%;max-width:430px;height:auto;border-radius:19px;display:block;margin:15px auto;box-shadow:0 10px 28px rgba(190,91,133,.16)}.signature{text-align:center;color:#d45f91;font-weight:750;margin:18px 0 4px}.tiny{text-align:center;color:#b98a9f;font-size:12px;margin:7px 0 0}
